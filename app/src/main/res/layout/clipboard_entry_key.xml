<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/clipboard_entry_image_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/clipboard_entry_text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="4"/>
    </LinearLayout>

    <ImageView
            android:id="@+id/clipboard_entry_pinned_icon"
            android:contentDescription="@string/clipboard_history_pinned_first"
            android:layout_width="@dimen/config_clipboard_pinned_icon_size"
            android:layout_height="@dimen/config_clipboard_pinned_icon_size"
            android:layout_marginVertical="8dp"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:soundEffectsEnabled="false"
            android:hapticFeedbackEnabled="false"/>

    <ImageView
            android:id="@+id/clipboard_entry_delete_icon"
            android:contentDescription="@string/delete"
            android:layout_width="@dimen/config_clipboard_pinned_icon_size"
            android:layout_height="@dimen/config_clipboard_pinned_icon_size"
            android:layout_marginVertical="8dp"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:soundEffectsEnabled="false"
            android:hapticFeedbackEnabled="false"
            android:src="@drawable/sym_keyboard_clear_clipboard_holo"/>

</LinearLayout>
